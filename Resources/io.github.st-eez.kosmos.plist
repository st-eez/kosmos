<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Launch at login, registered with SMAppService from Contents/Library/LaunchAgents.
KeepAlive restarts Kosmos after a crash or a failed start, and not after a quit (exit 0).
launchd starts a job at most once per ThrottleInterval: a crash after at least 30 s of
running restarts at once, and a crash loop restarts once every 30 s.
The guardian runs in its own process group, so launchd leaves it alive when the job dies.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.st-eez.kosmos</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Kosmos</string>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<!-- Without a ProcessType, launchd throttles the job's CPU and I/O. -->
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
